VkMemoryPropertyFlagBits :: enum_flags u32 {
    DEVICE_LOCAL_BIT :: 0x1; // If otherwise stated, then allocate memory on device
    HOST_VISIBLE_BIT :: 0x2; // Memory is mappable by host
    HOST_COHERENT_BIT :: 0x4; // Memory will have i/o coherency. If not set, application may need to use vkFlushMappedMemoryRanges and vkInvalidateMappedMemoryRanges to flush/invalidate host cache
    HOST_CACHED_BIT :: 0x8; // Memory will be cached by the host
    LAZILY_ALLOCATED_BIT :: 0x10; // Memory may be allocated by the driver when it is required
    PROTECTED_BIT :: 0x20; // Memory is protected
    DEVICE_COHERENT_BIT_AMD :: 0x40;
    DEVICE_UNCACHED_BIT_AMD :: 0x80;
    RDMA_CAPABLE_BIT_NV :: 0x100;

    VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT :: DEVICE_LOCAL_BIT;
    VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT :: HOST_VISIBLE_BIT;
    VK_MEMORY_PROPERTY_HOST_COHERENT_BIT :: HOST_COHERENT_BIT;
    VK_MEMORY_PROPERTY_HOST_CACHED_BIT :: HOST_CACHED_BIT;
    VK_MEMORY_PROPERTY_LAZILY_ALLOCATED_BIT :: LAZILY_ALLOCATED_BIT;
    VK_MEMORY_PROPERTY_PROTECTED_BIT :: PROTECTED_BIT;
    VK_MEMORY_PROPERTY_DEVICE_COHERENT_BIT_AMD :: DEVICE_COHERENT_BIT_AMD;
    VK_MEMORY_PROPERTY_DEVICE_UNCACHED_BIT_AMD :: DEVICE_UNCACHED_BIT_AMD;
    VK_MEMORY_PROPERTY_RDMA_CAPABLE_BIT_NV :: RDMA_CAPABLE_BIT_NV;
}

VkMemoryHeapFlagBits :: enum_flags u32 {
    DEVICE_LOCAL_BIT :: 0x1; // If set, heap represents device memory
    MULTI_INSTANCE_BIT :: 0x2; // If set, heap allocations allocate multiple instances by default
    MULTI_INSTANCE_BIT_KHR :: 0x2;
    TILE_MEMORY_BIT_QCOM :: 0x8;

    VK_MEMORY_HEAP_DEVICE_LOCAL_BIT :: DEVICE_LOCAL_BIT;
    VK_MEMORY_HEAP_MULTI_INSTANCE_BIT :: MULTI_INSTANCE_BIT;
    VK_MEMORY_HEAP_MULTI_INSTANCE_BIT_KHR :: MULTI_INSTANCE_BIT_KHR;
    VK_MEMORY_HEAP_TILE_MEMORY_BIT_QCOM :: TILE_MEMORY_BIT_QCOM;
}

VkAccessFlagBits :: enum_flags u32 {
    INDIRECT_COMMAND_READ_BIT :: 0x1; // Controls coherency of indirect command reads
    INDEX_READ_BIT :: 0x2; // Controls coherency of index reads
    VERTEX_ATTRIBUTE_READ_BIT :: 0x4; // Controls coherency of vertex attribute reads
    UNIFORM_READ_BIT :: 0x8; // Controls coherency of uniform buffer reads
    INPUT_ATTACHMENT_READ_BIT :: 0x10; // Controls coherency of input attachment reads
    SHADER_READ_BIT :: 0x20; // Controls coherency of shader reads
    SHADER_WRITE_BIT :: 0x40; // Controls coherency of shader writes
