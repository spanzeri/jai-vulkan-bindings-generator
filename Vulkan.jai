VkQueueFlagBits :: enum_flags u32 {
    GRAPHICS_BIT :: 0x1; // Queue supports graphics operations
    COMPUTE_BIT :: 0x2; // Queue supports compute operations
    TRANSFER_BIT :: 0x4; // Queue supports transfer operations
    SPARSE_BINDING_BIT :: 0x8; // Queue supports sparse resource memory management operations
    PROTECTED_BIT :: 0x10; // Queues may support protected operations
