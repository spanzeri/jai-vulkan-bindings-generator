VkAccelerationStructureInstanceKHR :: struct {
    transform: VkTransformMatrixKHR;
    __bitfield: u32;
    __bitfield1: u32;
    accelerationStructureReference: u64;
}

get_instanceCustomIndex :: (s: VkAccelerationStructureInstanceKHR) -> u32 { return cast(u32) ((s.__bitfield >> 0) & 16777215); }
set_instanceCustomIndex :: (s: *VkAccelerationStructureInstanceKHR, value: u32) { s.__bitfield = (s.__bitfield & ~cast(u32)(16777215 << 0)) | ((cast(u32) value & 16777215) << 0); }
get_mask :: (s: VkAccelerationStructureInstanceKHR) -> u32 { return cast(u32) ((s.__bitfield >> 24) & 255); }
set_mask :: (s: *VkAccelerationStructureInstanceKHR, value: u32) { s.__bitfield = (s.__bitfield & ~cast(u32)(255 << 24)) | ((cast(u32) value & 255) << 24); }
get_instanceShaderBindingTableRecordOffset :: (s: VkAccelerationStructureInstanceKHR) -> u32 { return cast(u32) ((s.__bitfield1 >> 0) & 16777215); }
set_instanceShaderBindingTableRecordOffset :: (s: *VkAccelerationStructureInstanceKHR, value: u32) { s.__bitfield1 = (s.__bitfield1 & ~cast(u32)(16777215 << 0)) | ((cast(u32) value & 16777215) << 0); }
get_flags :: (s: VkAccelerationStructureInstanceKHR) -> VkGeometryInstanceFlagsKHR { return cast(VkGeometryInstanceFlagsKHR) ((s.__bitfield1 >> 24) & 255); }
set_flags :: (s: *VkAccelerationStructureInstanceKHR, value: VkGeometryInstanceFlagsKHR) { s.__bitfield1 = (s.__bitfield1 & ~cast(u32)(255 << 24)) | ((cast(u32) value & 255) << 24); }

VkAccelerationStructureInstanceNV :: VkAccelerationStructureInstanceKHR;

