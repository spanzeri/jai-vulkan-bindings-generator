VkQueryResultFlagBits :: enum_flags u32 {
    _64_BIT :: 0x1; // Results of the queries are written to the destination buffer as 64-bit values
    WAIT_BIT :: 0x2; // Results of the queries are waited on before proceeding with the result copy
    WITH_AVAILABILITY_BIT :: 0x4; // Besides the results of the query, the availability of the results is also written
    PARTIAL_BIT :: 0x8; // Copy the partial results of the query even if the final results are not available
    WITH_STATUS_BIT_KHR :: 0x10;

    VK_QUERY_RESULT_64_BIT :: _64_BIT;
    VK_QUERY_RESULT_WAIT_BIT :: WAIT_BIT;
    VK_QUERY_RESULT_WITH_AVAILABILITY_BIT :: WITH_AVAILABILITY_BIT;
    VK_QUERY_RESULT_PARTIAL_BIT :: PARTIAL_BIT;
    VK_QUERY_RESULT_WITH_STATUS_BIT_KHR :: WITH_STATUS_BIT_KHR;
}

