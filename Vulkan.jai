VkFormatFeatureFlagBits :: enum_flags u32 {
    SAMPLED_IMAGE_BIT :: 0x1; // Format can be used for sampled images (SAMPLED_IMAGE and COMBINED_IMAGE_SAMPLER descriptor types)
    STORAGE_IMAGE_BIT :: 0x2; // Format can be used for storage images (STORAGE_IMAGE descriptor type)
    STORAGE_IMAGE_ATOMIC_BIT :: 0x4; // Format supports atomic operations in case it is used for storage images
    UNIFORM_TEXEL_BUFFER_BIT :: 0x8; // Format can be used for uniform texel buffers (TBOs)
    STORAGE_TEXEL_BUFFER_BIT :: 0x10; // Format can be used for storage texel buffers (IBOs)
    STORAGE_TEXEL_BUFFER_ATOMIC_BIT :: 0x20; // Format supports atomic operations in case it is used for storage texel buffers
    VERTEX_BUFFER_BIT :: 0x40; // Format can be used for vertex buffers (VBOs)
    COLOR_ATTACHMENT_BIT :: 0x80; // Format can be used for color attachment images
    COLOR_ATTACHMENT_BLEND_BIT :: 0x100; // Format supports blending in case it is used for color attachment images
    DEPTH_STENCIL_ATTACHMENT_BIT :: 0x200; // Format can be used for depth/stencil attachment images
    BLIT_SRC_BIT :: 0x400; // Format can be used as the source image of blits with vkCmdBlitImage
    BLIT_DST_BIT :: 0x800; // Format can be used as the destination image of blits with vkCmdBlitImage
    SAMPLED_IMAGE_FILTER_LINEAR_BIT :: 0x1000; // Format can be filtered with VK_FILTER_LINEAR when being sampled
    TRANSFER_SRC_BIT :: 0x4000; // Format can be used as the source image of image transfer commands
    TRANSFER_DST_BIT :: 0x8000; // Format can be used as the destination image of image transfer commands
    MIDPOINT_CHROMA_SAMPLES_BIT :: 0x20000; // Format can have midpoint rather than cosited chroma samples
    SAMPLED_IMAGE_YCBCR_CONVERSION_LINEAR_FILTER_BIT :: 0x40000; // Format can be used with linear filtering whilst color conversion is enabled
    SAMPLED_IMAGE_YCBCR_CONVERSION_SEPARATE_RECONSTRUCTION_FILTER_BIT :: 0x80000; // Format can have different chroma, min and mag filters
    SAMPLED_IMAGE_YCBCR_CONVERSION_CHROMA_RECONSTRUCTION_EXPLICIT_BIT :: 0x100000;
    SAMPLED_IMAGE_YCBCR_CONVERSION_CHROMA_RECONSTRUCTION_EXPLICIT_FORCEABLE_BIT :: 0x200000;
    DISJOINT_BIT :: 0x400000; // Format supports disjoint planes
    COSITED_CHROMA_SAMPLES_BIT :: 0x800000; // Format can have cosited rather than midpoint chroma samples
    SAMPLED_IMAGE_FILTER_MINMAX_BIT :: 0x10000; // Format can be used with min/max reduction filtering
    SAMPLED_IMAGE_FILTER_CUBIC_BIT_IMG :: 0x2000; // Format can be filtered with VK_FILTER_CUBIC_IMG when being sampled
